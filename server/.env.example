# Copy to server/.env and fill in. Never commit .env.
# The single shared secret you type into /login (and send as X-Api-Key from scripts).
ACCESS_KEY=change-me-to-a-long-random-string
# Signs the session cookie and download tokens. Generate: python3 -c 'import secrets;print(secrets.token_urlsafe(48))'
SECRET=change-me-too
# Public origin of the site (scheme matters: https => Secure cookie).
PUBLIC_BASE_URL=https://media.example.com
# Caddy site address (hostname only, or "localhost" / ":80" for local testing).
SITE_ADDRESS=media.example.com
# Optional Netscape cookies.txt for yt-dlp fallbacks (protected tweets, TikTok if the droplet IP is blocked).
# Mounted read-only into the container at /run/secrets/cookies.txt by docker-compose when set.
#COOKIES_PATH=/run/secrets/cookies.txt
# Gif conversion
GIF_FPS=15
GIF_MAX_WIDTH=480
GIF_KEEP_MP4_DEFAULT=true
# Zip endpoint for multi-item posts (page setting; server always exposes /v1/zip)
ZIP_MULTI_DEFAULT=false
# Where converted gifs / temps live inside the container
DATA_DIR=/data
# Rate limit for /v1/resolve
RESOLVE_LIMIT=30
RESOLVE_WINDOW_SECONDS=300
