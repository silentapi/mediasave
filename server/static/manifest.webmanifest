{
  "name": "Media Saver",
  "short_name": "Media Saver",
  "description": "Share a Twitter/X or TikTok post here to save its media.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#111111",
  "theme_color": "#111111",
  "icons": [
    { "src": "/static/icons/192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/static/icons/512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/static/icons/maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
